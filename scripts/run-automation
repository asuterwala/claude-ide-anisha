#!/usr/bin/env bash
# Claude IDE — automation run engine.
# Usage: run-automation <automation-id> [trigger]
# trigger: schedule (default) | manual | catchup
set -uo pipefail

AUTOMATION_ID="${1:-}"
TRIGGER="${2:-schedule}"
[ -z "$AUTOMATION_ID" ] && { echo "missing automation id" >&2; exit 2; }

CLAUDE_IDE_DIR="$HOME/.claude-ide"
AUTOMATIONS_FILE="$CLAUDE_IDE_DIR/automations.json"
RUNS_DIR="$CLAUDE_IDE_DIR/runs"
ENV_FILE="$CLAUDE_IDE_DIR/env.json"

[ -f "$AUTOMATIONS_FILE" ] || { echo "automations.json missing" >&2; exit 3; }

# Every config/dependency lookup below uses jq. If it's missing, the script
# would silently produce empty strings and downstream `claude` invocation
# would fail with cryptic errors. Bail early with a useful message instead.
# Install via: brew install jq
command -v jq >/dev/null 2>&1 || {
  echo "run-automation: jq not found. Install with: brew install jq" >&2
  exit 5
}

# Source plist-equivalent env so PATH includes claude
if [ -f "$ENV_FILE" ]; then
  export HOME="$(jq -r '.HOME' "$ENV_FILE")"
  export PATH="$(jq -r '.PATH' "$ENV_FILE")"
  export CLAUDE_CODE_USE_BEDROCK="$(jq -r '.CLAUDE_CODE_USE_BEDROCK' "$ENV_FILE")"
fi

ENTRY=$(jq -c --arg id "$AUTOMATION_ID" '.[] | select(.id == $id)' "$AUTOMATIONS_FILE")
[ -z "$ENTRY" ] && { echo "automation not found: $AUTOMATION_ID" >&2; exit 4; }

NAME=$(echo "$ENTRY" | jq -r '.name')
SKILL=$(echo "$ENTRY" | jq -r '.skill')
FOLDER=$(echo "$ENTRY" | jq -r '.folder' | sed "s|^~|$HOME|")
TIMEOUT_MIN=$(echo "$ENTRY" | jq -r '.timeoutMin')
MODEL=$(echo "$ENTRY" | jq -r '.model')
DEPENDS_ON=$(echo "$ENTRY" | jq -r '.dependsOn | join(" ")')

TS="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_DIR="$RUNS_DIR/${AUTOMATION_ID}__${TS}"
mkdir -p "$RUN_DIR"
STATUS="$RUN_DIR/status.json"
LOG="$RUN_DIR/run.log"

write_status() {
  jq -n \
    --arg runId "${AUTOMATION_ID}__${TS}" \
    --arg automationId "$AUTOMATION_ID" \
    --arg state "$1" \
    --arg startedAt "$STARTED_AT" \
    --arg triggeredBy "$TRIGGER" \
    --arg finishedAt "${2:-}" \
    --argjson durationMs "${3:-null}" \
    --argjson exitCode "${4:-null}" \
    --argjson tokensUsed "${5:-null}" \
    --argjson costUsd "${6:-null}" \
    --arg failureReason "${7:-}" \
    '{runId:$runId, automationId:$automationId, state:$state, startedAt:$startedAt, finishedAt:($finishedAt | select(. != "") // null), durationMs:$durationMs, exitCode:$exitCode, tokensUsed:$tokensUsed, costUsd:$costUsd, triggeredBy:$triggeredBy, failureReason:($failureReason | select(. != "") // null)}' \
    > "$STATUS"
}

STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
write_status "running"

# Budget pre-check (scheduled runs only — manual/catchup bypass)
BUDGET=$(echo "$ENTRY" | jq -r '.monthlyBudgetUsd // empty')
if [ -n "$BUDGET" ] && [ "$TRIGGER" = "schedule" ]; then
  CURRENT_MONTH=$(date +%Y-%m)
  TOTAL=$(for f in "$RUNS_DIR"/"${AUTOMATION_ID}"__*/status.json; do
    [ -f "$f" ] || continue
    SD=$(jq -r '.startedAt' "$f")
    [ -z "$SD" ] && continue
    MONTH_OF=$(echo "$SD" | cut -c1-7)
    [ "$MONTH_OF" = "$CURRENT_MONTH" ] || continue
    jq -r '.costUsd // 0' "$f"
  done | awk '{s+=$1} END {print s+0}')
  if awk -v t="$TOTAL" -v b="$BUDGET" 'BEGIN { exit !(t > b) }'; then
    write_status "skipped_budget" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" 0 null null null "monthly budget exceeded ($TOTAL > $BUDGET)"
    exit 0
  fi
fi

# Dependency check: each upstream must have a completed run TODAY.
TODAY="$(date +%Y%m%d)"
for DEP in $DEPENDS_ON; do
  FOUND=0
  for d in "$RUNS_DIR"/"${DEP}"__"${TODAY}"*; do
    [ -f "$d/status.json" ] || continue
    STATE=$(jq -r '.state' "$d/status.json")
    if [ "$STATE" = "completed" ]; then FOUND=1; break; fi
  done
  if [ "$FOUND" = 0 ]; then
    FINISHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_status "skipped" "$FINISHED_AT" 0 null null null "dependency $DEP not completed today"
    exit 0
  fi
done

# Execute claude in folder with the skill activated.
# date +%s%3N is GNU-only; macOS BSD date doesn't support %3N, so use python3 for ms.
ms_now() { python3 -c 'import time;print(int(time.time()*1000))'; }
START_MS=$(ms_now)
cd "$FOLDER" || { write_status "failed" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" 0 1 null null "folder not found: $FOLDER"; exit 1; }

# `timeout` is GNU coreutils — not present on macOS by default. Try the
# obvious variants, then fall back to a python3 wrapper that mimics the
# coreutils behavior (exit 124 on timeout).
run_with_timeout() {
  local mins="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "${mins}m" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "${mins}m" "$@"
  else
    python3 -c '
import subprocess, sys
timeout_sec = int(sys.argv[1]) * 60
try:
  sys.exit(subprocess.run(sys.argv[2:], timeout=timeout_sec).returncode)
except subprocess.TimeoutExpired:
  sys.exit(124)
' "$mins" "$@"
  fi
}

set +e
run_with_timeout "$TIMEOUT_MIN" claude -p "/${SKILL}" --model "${MODEL}" > "$LOG" 2>&1
EXIT_CODE=$?
set -e

FINISHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
END_MS=$(ms_now)
DURATION=$((END_MS - START_MS))

# Best-effort cost + token extraction from log.
# Output must be valid JSON for --argjson — anything with K/M suffix or empty
# is normalized to "null" so jq doesn't choke and produce an empty status.json.
RAW_COST=$(grep -oE '\$[0-9]+\.[0-9]+' "$LOG" | tail -1 | sed 's/\$//' || echo "")
RAW_TOKENS=$(grep -oE '[0-9]+(\.[0-9]+)?[KM]? tokens' "$LOG" | tail -1 | sed -E 's/ tokens//' || echo "")
to_json_number() {
  case "$1" in
    *K) echo "$(awk -v v="${1%K}" 'BEGIN{printf "%.0f", v*1000}')" ;;
    *M) echo "$(awk -v v="${1%M}" 'BEGIN{printf "%.0f", v*1000000}')" ;;
    "" ) echo "null" ;;
    *)
      # Plain number or anything else — accept only if it parses as a number.
      if [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then echo "$1"; else echo "null"; fi
      ;;
  esac
}
COST=$(to_json_number "$RAW_COST")
TOKENS=$(to_json_number "$RAW_TOKENS")

if [ "$EXIT_CODE" = 124 ]; then
  write_status "timeout" "$FINISHED_AT" "$DURATION" "$EXIT_CODE" null null "exceeded ${TIMEOUT_MIN}min"
elif [ "$EXIT_CODE" = 0 ]; then
  write_status "completed" "$FINISHED_AT" "$DURATION" "$EXIT_CODE" "$TOKENS" "$COST"
else
  write_status "failed" "$FINISHED_AT" "$DURATION" "$EXIT_CODE" "$TOKENS" "$COST" "exit $EXIT_CODE"
fi
